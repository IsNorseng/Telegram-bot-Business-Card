import telebot
from telebot import types

# Укажите токен своего бота.
TOKEN = "YOUR_TOKEN_HERE"
bot = telebot.TeleBot(TOKEN)

# Клавиатура.
markup = types.ReplyKeyboardMarkup(resize_keyboard=True)
markup.row(
    types.KeyboardButton("Увлечения и навыки?"),
    types.KeyboardButton("Образование и опыт?"),
)
markup.row(
    types.KeyboardButton("Достижения?"),
    types.KeyboardButton("Ссылки на соц.сети?"),
)


@bot.message_handler(commands=["start", "help"])
def start(message):
    bot.send_message(
        message.chat.id,
        "Меня зовут ***, это моя визитка. "
        "Здесь ты можешь узнать обо мне чуть больше. "
        "Что ты хочешь узнать?",
        reply_markup=markup,
    )


def handle_hobbies(message):
    bot.send_message(message.chat.id, "Бла-бла-бла")


def handle_experience(message):
    bot.send_message(message.chat.id, "Бла-бла-бла")


def handle_achievements(message):
    bot.send_message(message.chat.id, "Бла-бла-бла")


def handle_socials(message):
    bot.send_message(
        message.chat.id,
        "Бла-бла-бла",
        disable_web_page_preview=True,
    )


@bot.message_handler(content_types=["text"])
def handle_message(message):
    handlers = {
        "Увлечения и навыки?": handle_hobbies,
        "Образование и опыт?": handle_experience,
        "Достижения?": handle_achievements,
        "Ссылки на соц.сети?": handle_socials,
    }

    handler = handlers.get(message.text)

    if handler is not None:
        handler(message)
    else:
        bot.send_message(
            message.chat.id,
            "Выбери интересующий раздел с помощью кнопок ниже.",
            reply_markup=markup,
        )


if __name__ == "__main__":
    bot.polling()
